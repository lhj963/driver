Ntypedef struct tagLFOSThread
N{
N	OS_STK *sp;				//栈顶指针
N	OS_STK *bottom;			//栈底指针
N	OS_STK *sp_init_ptr;	//堆顶初始指针
N	INT32U stack_freed;		//空闲堆栈
N
N	INT8U status;			//线程状态
N	INT32U dly_tick;		//延时节拍
N	INT32U use_cpu_tick;	//占用CPU的时间
N	OS_SEM *pSem;			//信号量
N
N}LFOSThread;
N
